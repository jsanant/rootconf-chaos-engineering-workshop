# Optional full in-Docker build when the network trusts registries (no MITM).
# Usage: docker build -f Dockerfile.golang --build-arg TARGETARCH=arm64 -t cnpg-loadgen:local .
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY main.go ./
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/loadgen .

FROM scratch
COPY --from=build /out/loadgen /loadgen
USER 65534:65534
EXPOSE 8080
ENTRYPOINT ["/loadgen"]
